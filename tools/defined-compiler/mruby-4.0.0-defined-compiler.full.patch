+static void
+gen_defined_protected_recv(codegen_scope *s, node *recv, int sym, enum mrb_defined_type kind, int safe)
+{
+  int catch_entry = catch_handler_new(s);
+  int begin = s->pc;
+  int skip = 0;
+
+  codegen(s, recv, VAL);
+  pop();
+  if (safe) {
+    skip = genjmp2_0(s, OP_JMPNIL, cursp(), VAL);
+  }
+  genop_3(s, OP_DEFINED, cursp(), sym, (uint16_t)kind);
+  if (safe) {
+    dispatch(s, skip);
+  }
+  int end = s->pc;
+  uint32_t done = genjmp_0(s, OP_JMP);
+  catch_handler_set(s, catch_entry, MRB_CATCH_RESCUE, begin, end, s->pc);
+  genop_1(s, OP_LOADNIL, cursp());
+  dispatch(s, done);
+  push();
+}
+
+static void codegen_defined_expr(codegen_scope *s, node *expr);
+
+static void
+codegen_defined_array(codegen_scope *s, node *elements)
+{
+  uint32_t fail_pos = JMPLINK_START;
+  node *e = elements;
+
+  while (e) {
+    if (e->car) {
+      if (is_splat_node(e->car)) {
+        gen_defined_lit(s, "expression");
+        return;
+      }
+      codegen_defined_expr(s, e->car);
+      pop();
+      fail_pos = genjmp2(s, OP_JMPNIL, cursp(), fail_pos, VAL);
+    }
+    e = e->cdr;
+  }
+  gen_defined_lit(s, "expression");
+  if (fail_pos != JMPLINK_START) {
+    uint32_t done = genjmp_0(s, OP_JMP);
+    pop();
+    dispatch_linked(s, fail_pos);
     genop_1(s, OP_LOADNIL, cursp());
+    dispatch(s, done);
+    push();
+  }
+}
+
+static void
+codegen_defined_expr(codegen_scope *s, node *expr)
+{
+  while (expr && (node_type(expr) == NODE_STMTS || node_type(expr) == NODE_BEGIN)) {
+    if (node_type(expr) == NODE_BEGIN) {
+      expr = begin_node(expr)->body;
+      continue;
+    }
+    node *list = stmts_node(expr)->stmts;
+    if (!list) {
+      expr = NULL;
+      break;
+    }
+    if (!list->cdr) {
+      expr = list->car;
+      continue;
+    }
+    gen_defined_lit(s, "expression");
+    return;
+  }
+
+  if (!expr) {
+    gen_defined_lit(s, "expression");
+    return;
+  }
+
+  switch (node_type(expr)) {
+  case NODE_NIL:
+    gen_defined_lit(s, "nil");
+    break;
+
+  case NODE_SELF:
+    gen_defined_lit(s, "self");
+    break;
+
+  case NODE_TRUE:
+    gen_defined_lit(s, "true");
+    break;
+
+  case NODE_FALSE:
+    gen_defined_lit(s, "false");
+    break;
+
+  case NODE_ZARRAY:
+    gen_defined_lit(s, "expression");
+    break;
+
+  case NODE_ARRAY:
+    codegen_defined_array(s, array_node(expr)->elements);
+    break;
+
+  case NODE_LVAR:
+  case NODE_DVAR:
+  case NODE_NVAR:
+    gen_defined_lit(s, "local-variable");
+    break;
+
+  case NODE_CONST:
+    genop_3(s, OP_DEFINED, cursp(), sym_idx(s, const_node(expr)->symbol), MRB_DEFINED_CONST);
+    push();
+    break;
+
+  case NODE_COLON3:
+    genop_1(s, OP_OCLASS, cursp());
+    genop_3(s, OP_DEFINED, cursp(), sym_idx(s, colon3_node(expr)->name), MRB_DEFINED_MCONST);
+    push();
+    break;
+
+  case NODE_COLON2:
+    {
+      struct mrb_ast_colon2_node *c2 = colon2_node(expr);
+      gen_defined_protected_recv(s, c2->base, sym_idx(s, c2->name), MRB_DEFINED_MCONST, 0);
+    }
+    break;
+
+  case NODE_GVAR:
+    genop_3(s, OP_DEFINED, cursp(), sym_idx(s, var_node(expr)->symbol), MRB_DEFINED_GVAR);
     push();
+    break;
+
+  case NODE_NTH_REF:
+    {
+      mrb_value str = mrb_format(s->mrb, "$%d", nth_ref_node(expr)->nth);
+      int sym = sym_idx(s, mrb_intern_str(s->mrb, str));
+      genop_3(s, OP_DEFINED, cursp(), sym, MRB_DEFINED_GVAR);
+      push();
+    }
+    break;
+
+  case NODE_BACK_REF:
+    {
+      char buf[] = {'$', (char)back_ref_node(expr)->type};
+      int sym = sym_idx(s, mrb_intern(s->mrb, buf, sizeof(buf)));
+      genop_3(s, OP_DEFINED, cursp(), sym, MRB_DEFINED_GVAR);
+      push();
+    }
+    break;
+
+  case NODE_IVAR:
+    genop_3(s, OP_DEFINED, cursp(), sym_idx(s, var_node(expr)->symbol), MRB_DEFINED_IVAR);
+    push();
+    break;
+
+  case NODE_CVAR:
+    genop_3(s, OP_DEFINED, cursp(), sym_idx(s, var_node(expr)->symbol), MRB_DEFINED_CVAR);
+    push();
+    break;
+
+  case NODE_ASGN:
+    {
+      node *lhs = asgn_node(expr)->lhs;
+      if (lhs && node_type(lhs) == NODE_CALL) {
+        struct mrb_ast_call_node *call = call_node(lhs);
+        int sym = sym_idx(s, attrsym(s, call->method_name));
+        if (!call->receiver) {
+          genop_3(s, OP_DEFINED, cursp(), sym, MRB_DEFINED_FCALL);
+          push();
+        }
+        else {
+          gen_defined_protected_recv(s, call->receiver, sym, MRB_DEFINED_CALL, call->safe_call);
+        }
+      }
+      else {
+        gen_defined_lit(s, "assignment");
+      }
+    }
+    break;
+
+  case NODE_OP_ASGN:
+  case NODE_MASGN:
+    gen_defined_lit(s, "assignment");
+    break;
+
+  case NODE_CALL:
+    {
+      struct mrb_ast_call_node *call = call_node(expr);
+      int sym = sym_idx(s, call->method_name);
+      if (!call->receiver) {
+        genop_3(s, OP_DEFINED, cursp(), sym, MRB_DEFINED_FCALL);
+        push();
+      }
+      else {
+        gen_defined_protected_recv(s, call->receiver, sym, MRB_DEFINED_CALL, call->safe_call);
+      }
+    }
+    break;
+
+  case NODE_YIELD:
+    {
+      codegen_scope *s2 = s;
+      while (s2 && !s2->mscope) {
+        s2 = s2->prev;
+      }
+      if (!s2 && s->parser->upper == NULL) {
+        genop_1(s, OP_LOADNIL, cursp());
+      }
+      else {
+        genop_3(s, OP_DEFINED, cursp(), 0, MRB_DEFINED_YIELD);
+      }
+      push();
+    }
+    break;
+
+  case NODE_SUPER:
+  case NODE_ZSUPER:
+    genop_3(s, OP_DEFINED, cursp(), 0, MRB_DEFINED_SUPER);
+    push();
+    break;
+
+  default:
+    gen_defined_lit(s, "expression");
+    break;
   }
 }
 
+static void
+codegen_defined(codegen_scope *s, node *varnode, int val)
+{
+  if (!val) return;
+  codegen_defined_expr(s, defined_node(varnode)->expr);
+}
