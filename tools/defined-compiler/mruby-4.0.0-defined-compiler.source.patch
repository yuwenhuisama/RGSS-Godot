+static void
+backref_resolve_scope(mrb_state *mrb, struct mrb_context **out_cxt, ptrdiff_t *out_ci_idx, struct REnv **out_env)
+{
+  *out_cxt = NULL;
+  *out_ci_idx = 0;
+  *out_env = NULL;
+
+  struct mrb_context *c = mrb->c;
+  if (!c || !c->cibase || !c->ci) {
+    *out_cxt = mrb->root_c;
+    *out_ci_idx = 0;
+    return;
+  }
+
+  /* Skip CFunc frames (e.g. OnigRegexp#match, String#sub, Regexp.last_match) to reach the Ruby caller */
+  mrb_callinfo *ci = c->ci;
+  while (ci > c->cibase && (!ci->proc || MRB_PROC_CFUNC_P(ci->proc))) {
+    ci--;
+  }
+
+  const struct RProc *p = ci->proc;
+  if (!p || MRB_PROC_CFUNC_P(p)) {
+    *out_cxt = c;
+    *out_ci_idx = 0;
+    return;
+  }
+
+  /* `def` method / class / module / top-level scope: MRB_PROC_SCOPE without closure env */
+  if (MRB_PROC_SCOPE_P(p) && !MRB_PROC_ENV_P(p)) {
+    *out_cxt = c;
+    *out_ci_idx = ci - c->cibase;
+    return;
+  }
+
+  /* `define_method` invocation: MRB_PROC_SCOPE && MRB_PROC_STRICT && MRB_PROC_ENV_P.
+     In Ruby 1.9 / RGSS300, define_method has its own isolated method-frame $~ per call! */
+  if (MRB_PROC_SCOPE_P(p) && MRB_PROC_STRICT_P(p) && MRB_PROC_ENV_P(p)) {
+    *out_cxt = c;
+    *out_ci_idx = ci - c->cibase;
+    return;
+  }
+
+  /* Block, proc, lambda, or Kernel#eval string: walk lexical upper chain to the enclosing
+     method / class / top scope (or enclosing define_method frame). */
+  struct REnv *outer_env = NULL;
+  const struct RProc *cur = p;
+  while (cur) {
+    if (MRB_PROC_SCOPE_P(cur)) {
+      if (MRB_PROC_ENV_P(cur) && MRB_PROC_STRICT_P(cur)) {
+        /* Enclosing scope is a `define_method` proc: find its active frame on stack if any */
+        for (mrb_callinfo *scan = ci; scan > c->cibase; scan--) {
+          if (scan->proc == cur) {
+            *out_cxt = c;
+            *out_ci_idx = scan - c->cibase;
+            return;
+          }
+        }
+      }
+      break;
+    }
+    if (MRB_PROC_ENV_P(cur)) {
+      outer_env = MRB_PROC_ENV(cur);
+    }
+    cur = cur->upper;
+  }
+
+  if (outer_env) {
+    if (MRB_ENV_ONSTACK_P(outer_env) && outer_env->cxt) {
+      struct mrb_context *ec = outer_env->cxt;
+      if (ec->cibase && ec->ci) {
+        for (mrb_callinfo *scan = ec->ci; scan >= ec->cibase; scan--) {
+          if (mrb_vm_ci_env(scan) == outer_env) {
+            *out_cxt = ec;
+            *out_ci_idx = scan - ec->cibase;
+            return;
+          }
+        }
+      }
+    }
+    *out_env = outer_env;
+    return;
+  }
+
+  if (cur) {
+    for (mrb_callinfo *scan = ci; scan >= c->cibase; scan--) {
+      if (scan->proc == cur) {
+        *out_cxt = c;
+        *out_ci_idx = scan - c->cibase;
+        return;
+      }
+    }
+  }
+
+  /* Fiber created at top-level or fallback: root context base frame */
+  *out_cxt = mrb->root_c ? mrb->root_c : c;
+  *out_ci_idx = 0;
+}
