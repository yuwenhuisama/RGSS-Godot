+    case '~': return MRB_MSYM_TILDE;
+    case '&': return MRB_MSYM_AMP;
+    case '`': return MRB_MSYM_PRE;
+    case '\'': return MRB_MSYM_POST;
+    case '+': return MRB_MSYM_PLUS;
+    default: break;
