+/* Lexical-scope $~ (Regexp match backref) side table.
+ * Stored outside mrb_state / mrb_callinfo / REnv so sizeof(mrb_state) == 18864,
+ * offsetof(mrb_state, eStandardError_class) == 18800, and sizeof(REnv) <= sizeof(RVALUE)
+ * remain strictly unchanged. */
+struct mrb_backref_entry {
+  struct mrb_context *cxt; /* non-NULL while owned by active callinfo frame (cxt, ci_idx) */
+  ptrdiff_t ci_idx;
+  struct REnv *env;        /* non-NULL when promoted to heap lexical REnv */
+  mrb_value match;
+};
+
+struct mrb_backref_state {
+  mrb_state *mrb;
+  struct mrb_backref_entry *entries;
+  size_t len;
+  size_t capa;
+  struct mrb_backref_state *next;
+};
+
+static struct mrb_backref_state *mrb_backref_states = NULL;
+
+static struct mrb_backref_state*
+backref_state_find(mrb_state *mrb, mrb_bool create)
+{
+  struct mrb_backref_state *st = mrb_backref_states;
+  while (st) {
+    if (st->mrb == mrb) return st;
+    st = st->next;
+  }
+  if (!create) return NULL;
+  st = (struct mrb_backref_state*)mrb_malloc(mrb, sizeof(struct mrb_backref_state));
+  st->mrb = mrb;
+  st->entries = NULL;
+  st->len = 0;
+  st->capa = 0;
+  st->next = mrb_backref_states;
+  mrb_backref_states = st;
+  return st;
+}
+
+static void
+backref_put(mrb_state *mrb, struct mrb_context *cxt, ptrdiff_t ci_idx, struct REnv *env, mrb_value val)
+{
+  struct mrb_backref_state *st = backref_state_find(mrb, !mrb_nil_p(val));
+  if (!st) return;
+
+  for (size_t i = 0; i < st->len; i++) {
+    struct mrb_backref_entry *e = &st->entries[i];
+    if ((env && e->env == env) || (!env && e->cxt == cxt && e->ci_idx == ci_idx)) {
+      if (mrb_nil_p(val)) {
+        st->entries[i] = st->entries[--st->len];
+      }
+      else {
+        e->match = val;
+      }
+      return;
+    }
+  }
+  if (mrb_nil_p(val)) return;
+
+  if (st->len == st->capa) {
+    size_t new_capa = st->capa ? st->capa * 2 : 8;
+    st->entries = (struct mrb_backref_entry*)mrb_realloc(mrb, st->entries, new_capa * sizeof(struct mrb_backref_entry));
+    st->capa = new_capa;
+  }
+  st->entries[st->len].cxt = env ? NULL : cxt;
+  st->entries[st->len].ci_idx = env ? 0 : ci_idx;
+  st->entries[st->len].env = env;
+  st->entries[st->len].match = val;
+  st->len++;
+}
+
+static mrb_value
+backref_lookup(mrb_state *mrb, struct mrb_context *cxt, ptrdiff_t ci_idx, struct REnv *env)
+{
+  struct mrb_backref_state *st = backref_state_find(mrb, FALSE);
+  if (!st) return mrb_nil_value();
+
+  for (size_t i = 0; i < st->len; i++) {
+    struct mrb_backref_entry *e = &st->entries[i];
+    if ((env && e->env == env) || (!env && e->cxt == cxt && e->ci_idx == ci_idx)) {
+      return e->match;
+    }
+  }
+  return mrb_nil_value();
+}
