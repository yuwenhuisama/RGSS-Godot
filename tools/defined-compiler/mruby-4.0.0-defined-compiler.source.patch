+  if (s[1] >= '1' && s[1] <= '9') {
+    mrb_int n = 0;
+    for (mrb_int i = 1; i < len; i++) {
+      if (s[i] < '0' || s[i] > '9') return MRB_MSYM_NONE;
+      if (n > (MRB_INT_MAX - 9) / 10) return MRB_MSYM_NONE;
